{
  "name": "graph-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "emulators": "firebase emulators:start --project demo-graph-visualizer --only auth,firestore",
    "preview": "vite preview",
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:unit": "playwright test --project=unit",
    "test:rules": "firebase emulators:exec --project demo-graph-visualizer --only firestore \"playwright test --project=rules\""
  },
  "dependencies": {
    "@formkit/auto-animate": "0.10.0",
    "cytoscape": "^3.34.4",
    "cytoscape-edgehandles": "^4.0.1",
    "excel-column-name": "^1.0.1",
    "firebase": "^13.2.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.58",
    "@tailwindcss/vite": "^4.3.4",
    "@types/cytoscape-edgehandles": "^4.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
